ENVIRONMENT=production
DEBUG=false

DB_USER=YOUR_AZURE_POSTGRES_ADMIN_USERNAME
DB_PASSWORD=REPLACE_WITH_YOUR_AZURE_PASSWORD
DB_HOST=YOUR_SERVER_NAME.postgres.database.azure.com
DB_PORT=5432
DB_NAME=undox_dev
DB_SSLMODE=require

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
