# ==========================================
# UNDOX Project .gitignore
# ==========================================

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Python Environments & Packages
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node.js & Next.js Frontend
node_modules/
.next/
out/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets (Keep confidential configs out of git)
.env
.env*.local
*.env
*.pem
*.key

# Database & Local Storage Files
*.sqlite
*.sqlite3
*.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
